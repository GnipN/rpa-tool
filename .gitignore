# ── Virtual environment ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Distribution / build ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
wheels/

# ── EasyOCR model cache ───────────────────────────────────────────────────────
# Downloaded on first run (~300 MB), not needed in source control
.EasyOCR/

# ── PyInstaller ───────────────────────────────────────────────────────────────
*.spec
dist/
build/

# ── Pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# ── Generated files ──────────────────────────────────────────────────────────
# Auto-generated by install.bat
run.bat

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS artifacts ─────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
*.temp

# ── Screenshots / captured images saved during OCR testing ───────────────────
captures/
screenshots/

# ── Secrets / environment variables ─────────────────────────────────────────
.env
.env.*
secrets.*
